{
  "name": "awp-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev:world dev:agent dev:ui",
    "sorter": "turbo run dev:world dev:agent dev:ui --filter=sorter",
    "vault": "turbo run dev:world dev:agent dev:ui --filter=vault",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3"
  }
}
